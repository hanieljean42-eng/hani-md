# ========================================
# Configuration HANI-MD - Bot WhatsApp
# Par H2025 - VERSION SÉCURISÉE v2.0
# ========================================

# ========================================
# 🔒 SÉCURITÉ (OBLIGATOIRE - À CHANGER!)
# ========================================

# Mot de passe admin pour le panel web (CHANGEZ ABSOLUMENT CE MOT DE PASSE!)
ADMIN_PASSWORD=VotreMotDePasseSecurise123!

# Secret pour le chiffrement (32 caractères minimum)
HANI_AUTH_SECRET=VotreSecretAuth32CaracteresMin!
HANI_SESSION_SECRET=VotreSecretSession32CarsMin!

# ========================================
# ⚙️ CONFIGURATION GÉNÉRALE
# ========================================

# Préfixe des commandes (ex: .menu, .help)
PREFIXE=.

# Ton nom (propriétaire du bot)
NOM_OWNER=MonNom

# Ton numéro WhatsApp (format international sans +)
# Ex: France: 33612345678, Côte d'Ivoire: 2250101234567
NUMERO_OWNER=22501XXXXXXXX

# Mode du bot: public (tout le monde) ou private (toi seul)
MODE=public

# Nom du pack de stickers
STICKER_PACK_NAME=HANI-MD

# Auteur des stickers
STICKER_AUTHOR_NAME=MonNom

# ========================================
# NOTIFICATIONS ESPION (Optionnel)
# ========================================

# Numéro qui recevra les notifications espion
# (lectures, présences, vues statuts, etc.)
# Laissez vide pour utiliser le numéro du bot
NOTIFICATION_NUMBER=

# ========================================
# SESSION POUR DÉPLOIEMENT
# ========================================

# Session encodée chiffrée (générée automatiquement après scan QR)
# Format V2: HANI-MD-V2~{données_chiffrées_AES256}
SESSION_ID=

# ========================================
# BASE DE DONNÉES MYSQL (Optionnel)
# ========================================

# Hébergeurs MySQL gratuits:
# - PlanetScale: https://planetscale.com (5GB gratuit)
# - Railway: https://railway.app (500MB gratuit)  
# - FreeSQLDatabase: https://freesqldatabase.com
# - db4free.net: https://db4free.net
# - Clever Cloud: https://clever-cloud.com
#
# Option 1: URL complète (recommandé pour déploiement)
# MYSQL_URL=mysql://user:password@host:3306/database
#
# Option 2: Variables séparées (pour développement local)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=hani_db
MYSQL_SSL=false

# ========================================
# � PAIEMENTS WAVE / JEKO (Optionnel)
# ========================================

# Lien de paiement Jeko (votre lien pay.jeko.africa/pl/...)
JEKO_PAYMENT_LINK=https://pay.jeko.africa/pl/2a5354be-710e-454e-8741-1b3d6beb5890

# Clé API Wave Business (pour vérification automatique avancée)
WAVE_API_KEY=

# ID Marchand Wave
WAVE_MERCHANT_ID=

# Numéro Wave du marchand (pour paiements manuels)
WAVE_ACCOUNT=

# ========================================
# 🔥 FIREBASE (RECOMMANDÉ — 100% gratuit)
# ========================================
# Plus fiable que MySQL gratuit (Google infrastructure)
# Gratuit: 1GB stockage, 10GB/mois transfert
#
# Comment obtenir ces valeurs:
# 1. Va sur https://console.firebase.google.com
# 2. "Créer un projet" → nom: hani-md
# 3. Realtime Database → Créer une base de données → mode test
# 4. Copie l'URL (ex: https://hani-md-xxxxx-default-rtdb.firebaseio.com)
# 5. Paramètres projet → Comptes de service → Générer une clé privée
# 6. Ouvre le JSON téléchargé → copie TOUT le contenu sur une seule ligne

# URL Realtime Database (ton projet hani-md est déjà créé)
FIREBASE_URL=https://hani-md-default-rtdb.firebaseio.com

# Clé service account: console.firebase.google.com/project/hani-md/settings/serviceaccounts/adminsdk
# → Générer une nouvelle clé privée → copier le JSON complet sur UNE SEULE LIGNE
FIREBASE_CREDENTIALS={"type":"service_account","project_id":"hani-md","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxxx@hani-md.iam.gserviceaccount.com"}

# ========================================
# 🤖 APIs INTELLIGENCE ARTIFICIELLE
# ========================================

# Clé API Google Gemini (OBLIGATOIRE pour .gpt, .gemini, .code, etc.)
# Obtenez une clé GRATUITE sur: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Clé API TMDB pour recherche de films (optionnel - clé publique incluse)
# Obtenez votre clé sur: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Clé API Remove.bg pour suppression d'arrière-plan (optionnel)
# Obtenez 50 crédits gratuits/mois sur: https://www.remove.bg/api
REMOVEBG_API_KEY=

# ========================================
# 🚀 DÉPLOIEMENT
# ========================================

# URL publique du bot (utilisée pour les redirections de paiement)
# Fly.io: https://hani-md.fly.dev
BOT_URL=https://hani-md.fly.dev

# Port du serveur web
PORT=3000

# Environnement
NODE_ENV=production
